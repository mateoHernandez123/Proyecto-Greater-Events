  "item": [
    {
      "name": "0 — Autenticación (obtener token)",
      "auth": {
        "type": "noauth"
      },
      "description": "Corré **Login admin** o **Login end-user**: el token se guarda en el environment y en la colección (variable `accessToken`). **Todos los endpoints protegidos usan `{{accessToken}}` automáticamente** — no hace falta navegador ni Get New Access Token.\n\nRequiere Direct Access Grants ON en el client `pdyc` (ya habilitado en local). Cambiá de rol simplemente corriendo el otro Login.",
      "item": [
        {
          "name": "Login admin (tp3-user) → guarda accessToken/refreshToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "  pm.environment.set('accessToken', j.access_token);",
                  "  pm.environment.set('refreshToken', j.refresh_token);",
                  "  console.log('Token ADMIN guardado (colección + environment). Expira en', j.expires_in, 's');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloakClientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{adminUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                }
              ]
            },
            "url": "{{keycloakTokenUrl}}",
            "description": "Login de tp3-user (rol admin). Guarda accessToken y refreshToken en la colección."
          }
        },
        {
          "name": "Login end-user (tp4-user) → guarda accessToken/refreshToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "  pm.environment.set('accessToken', j.access_token);",
                  "  pm.environment.set('refreshToken', j.refresh_token);",
                  "  console.log('Token USER guardado (colección + environment). Expira en', j.expires_in, 's');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloakClientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{endUserUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{endUserPassword}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                }
              ]
            },
            "url": "{{keycloakTokenUrl}}",
            "description": "Login de tp4-user (rol user). Guarda accessToken y refreshToken en la colección."
          }
        },
        {
          "name": "Refresh access token → actualiza accessToken/refreshToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.environment.set('accessToken', j.access_token);",
                  "  if (j.refresh_token) { pm.collectionVariables.set('refreshToken', j.refresh_token); pm.environment.set('refreshToken', j.refresh_token); }",
                  "  console.log('Token renovado sin re-login (colección + environment).');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloakClientSecret}}"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}"
                }
              ]
            },
            "url": "{{keycloakTokenUrl}}",
            "description": "Usa el refreshToken guardado por un login previo para obtener un access_token nuevo sin volver a ingresar credenciales (grant refresh_token, Anexo TP4)."
          }
        }
      ]
    },

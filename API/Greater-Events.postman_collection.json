    {
      "name": "Flujo demo (en orden)",
      "description": "Automatizado con `{{accessToken}}`. Antes de los pasos de **user** (3, 4, 5, 7, 8) corré **Login end-user**; antes del **Paso 6** (admin) corré **Login admin**. Cada paso indica el rol.",
      "item": [
        {
          "name": "Paso 1 — List active artists (público)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/artists",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Paso 2 — Tentative = 404 (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/1",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Paso 3 — Follow artist (tp4-user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artist_id\": 1\n}"
            },
            "url": "{{baseUrl}}/me/following"
          }
        },
        {
          "name": "Paso 4 — Add favorite event 20 (tp4-user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": 20\n}"
            },
            "url": "{{baseUrl}}/me/favorite-events"
          }
        },
        {
          "name": "Paso 5 — Events de artistas seguidos (tp4-user)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/following/events"
          }
        },
        {
          "name": "Paso 6 — Reschedule event 20 (tp3-user admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2030-05-10T21:00:00\"\n}"
            },
            "url": "{{baseUrl}}/admin/events/20/rescheduled",
            "description": "Reprograma el evento 20 (favorito de tp4-user) → dispara la notificación vía RabbitMQ. Esperá 1-2 segundos. Se usa reschedule (no cancel) para que el evento siga vivo y puedas repetir la demo en los ensayos."
          }
        },
        {
          "name": "Paso 7 — List notifications (tp4-user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hay notificaciones', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.length).to.be.above(0);",
                  "  pm.collectionVariables.set('notificationId', String(data[0].id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/notifications"
          }
        },
        {
          "name": "Paso 8 — Mark notification read (tp4-user)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/me/notifications/{{notificationId}}/read"
          }
        }
      ]
